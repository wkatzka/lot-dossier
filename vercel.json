{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/parcel-docs.js": { "maxDuration": 300 },
    "api/notices.js": { "maxDuration": 300 }
  },
  "headers": [
    { "source": "/api/(.*)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
