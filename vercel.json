{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/parcel-docs.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    },
    "api/notices.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    },
    "api/plat-sheet.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    },
    "api/packet-ocr.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,pdfjs-dist/legacy/build}/**"
    },
    "api/watch.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
