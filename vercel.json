{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/parcel-docs.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    },
    "api/notices.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    },
    "api/plat-sheet.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core}/**"
    },
    "api/packet-ocr.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/{tesseract.js,tesseract.js-core,pdfjs-dist/legacy/build}/**"
    },
    "api/watch.js": {
      "maxDuration": 60
    },
    "api/plat-bundle.js": {
      "maxDuration": 300
    },
    "api/survey-document.js": {
      "maxDuration": 90,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    },
    "api/public-research.js": {
      "maxDuration": 300
    },
    "api/original-document.js": {
      "maxDuration": 120,
      "includeFiles": "{lib/original-reader-worker.js,node_modules/@napi-rs/**,node_modules/tesseract.js/**,node_modules/tesseract.js-core/**,node_modules/pdfjs-dist/legacy/build/**}"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
